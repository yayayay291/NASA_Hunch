import csv
import time
from datetime import datetime, timedelta

SLEEP_HRS = 8.5
PRE_SLEEP_HRS = 2
RECOVERY_HRS = 1.5
NAP_MINUTES = 26
CAFFEINE_CUTOFF = 8
NAP_AFTER_WAKE_HRS = 7
NAP_BUFFER_HRS = 4
SLEEP_AID_MIN = 30
EMERGENCY_NAP_MIN = 20

USE_24_HR = True


def get_time(text):
    cleaned = text.strip().upper().replace("AM", " AM").replace("PM", " PM")
    cleaned = " ".join(cleaned.split())
    for fmt in ("%H:%M", "%I:%M %p", "%I %p"):
        try:
            return datetime.strptime(cleaned, fmt)
        except ValueError:
            pass
    raise ValueError(f"Could not read time: {text!r}")


def show_time(t):
    return t.strftime("%H:%M") if USE_24_HR else t.strftime("%I:%M %p")


def ask_yes_no(prompt):
    while True:
        answer = input(f"{prompt} (y/n): ").strip().lower()
        if answer in ("y", "yes"):
            return True
        if answer in ("n", "no"):
            return False
        print("Please enter y or n.")


def ask_time(prompt):
    while True:
        try:
            return get_time(input(prompt))
        except ValueError:
            example = "22:00" if USE_24_HR else "10:00 PM"
            print(f"Please enter a time like {example}.")


def ask_time_format():
    global USE_24_HR


def build_schedule(sleep, nap, sleep_aid):
    wake = sleep + timedelta(hours=SLEEP_HRS)
    pre_sleep = sleep - timedelta(hours=PRE_SLEEP_HRS)
    recovery_end = wake + timedelta(hours=RECOVERY_HRS)
    next_sleep = sleep + timedelta(hours=24)
    caffeine_cutoff = next_sleep - timedelta(hours=CAFFEINE_CUTOFF)

    rows = [
        ("Wake", show_time(wake), "", "Bright light"),
        ("Recovery", show_time(wake), show_time(recovery_end), ""),
        ("Caffeine window", show_time(recovery_end),
         show_time(caffeine_cutoff), ""),
    ]

    if nap:
        nap_start = wake + timedelta(hours=NAP_AFTER_WAKE_HRS)
        nap_end = nap_start + timedelta(minutes=NAP_MINUTES)
        latest_end = next_sleep - timedelta(hours=NAP_BUFFER_HRS)

        if nap_end > latest_end:
            nap_end = latest_end
            nap_start = nap_end - timedelta(minutes=NAP_MINUTES)

        if nap_start >= recovery_end:
            rows.append(("Nap", show_time(nap_start), show_time(nap_end), ""))
        else:
            rows.append(("Nap", "", "", "Skipped (no safe gap before sleep)"))

    rows.append(("Pre-sleep", show_time(pre_sleep), show_time(sleep),
                 "Dim lights"))

    if sleep_aid:
        aid_time = sleep - timedelta(minutes=SLEEP_AID_MIN)
        rows.append(("Sleep aid", show_time(aid_time), "", "Only if approved"))

    rows.append(("Sleep", show_time(sleep), show_time(wake),
                 "Dark, cool room"))
    return rows


def print_schedule(name, rows):
    header = ("Event", "Start", "End", "Notes")
    widths = [max(len(str(r[i])) for r in rows + [header]) for i in range(4)]
    print(f"\n{name}")
    for r in [header] + rows:
        print("  ".join(str(c).ljust(w) for c, w in zip(r, widths)).rstrip())
    print()


def emergency_alertness(start):
    nap_end = start + timedelta(minutes=EMERGENCY_NAP_MIN)
    print("\nEmergency alertness:")
    print("Caffeine:      ", show_time(start))
    print(f"{EMERGENCY_NAP_MIN}-minute nap: ", show_time(start),
          "-", show_time(nap_end))


def countdown_timer(minutes):
    try:
        for remaining in range(int(minutes * 60), 0, -1):
            mins, secs = divmod(remaining, 60)
            print(f"\rTime remaining: {mins:02d}:{secs:02d}", end="", flush=True)
            time.sleep(1)
        print("\rTime remaining: 00:00")
        print("*** ALARM ***\a")
    except KeyboardInterrupt:
        print("\nTimer cancelled.")


def load_crew_from_csv(path):
    crew = []
    yes = ("y", "yes", "true", "1")
    with open(path, newline="") as f:
        for row in csv.DictReader(f):
            try:
                crew.append((
                    row["name"].strip(),
                    get_time(row["sleep_time"]),
                    row["nap"].strip().lower() in yes,
                    row["sleep_aid"].strip().lower() in yes,
                ))
            except (KeyError, ValueError) as err:
                print(f"Skipping bad row {row}: {err}")
    return crew


def save_schedules_to_csv(path, schedules):
    with open(path, "w", newline="") as f:
        writer = csv.writer(f)
        for name, rows in schedules.items():
            writer.writerow([name])
            writer.writerow(["Event", "Start", "End", "Notes"])
            writer.writerows(rows)
            writer.writerow([])


def main():
    schedules = {}

    print("Crew Sleep Schedule Planner")
    ask_time_format()

    while True:
        print()
        print("1) Add a crewmember")
        print("2) Load crew from CSV")
        print("3) Emergency alertness plan")
        print("4) Start countdown timer")
        print("5) Save schedules to CSV")
        print("6) Quit")
        choice = input("Choose an option: ").strip()

        if choice == "1":
            name = input("Crewmember name: ").strip() or "Crewmember"
            sleep = ask_time("Planned sleep time: ")
            nap = ask_yes_no("Include a nap?")
            aid = ask_yes_no("Include an approved sleep aid reminder?")
            schedules[name] = build_schedule(sleep, nap, aid)
            print_schedule(name, schedules[name])

        elif choice == "2":
            path = input("CSV file path: ").strip()
            try:
                for name, sleep, nap, aid in load_crew_from_csv(path):
                    schedules[name] = build_schedule(sleep, nap, aid)
                    print_schedule(name, schedules[name])
            except FileNotFoundError:
                print(f"File not found: {path}")

        elif choice == "3":
            emergency_alertness(ask_time("Start time for emergency plan: "))

        elif choice == "4":
            try:
                countdown_timer(float(input("Countdown length in minutes: ")))
            except ValueError:
                print("Please enter a number.")

        elif choice == "5":
            if not schedules:
                print("No schedules to save yet.")
            else:
                path = input("Save as (e.g. schedules.csv): ").strip()
                save_schedules_to_csv(path or "schedules.csv", schedules)
                print("Saved.")

        elif choice == "6":
            break

        else:
            print("Please choose 1-6.")


if __name__ == "__main__":
    main()
